# ============================================================
# Vyaapti - Environment Configuration Template
# ============================================================
# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored — never commit real credentials.
#
# This single file is read by:
#   - backend/config/database.js   (Node API server)
#   - backend/test-astra-connection.js
#   - backend/routes/mlRoutes.js   (forwards these vars to the Python ML scripts it spawns)
#   - ml-models/clustering/kmeans_clustering.py
#   - ml-models/classification/random_forest_risk.py
#   - spark-jobs/chain-builder/generate-transactions.py
#   - spark-jobs/chain-builder/detect_chains_astra.py
#   - spark-jobs/chain-builder/upload_chains_to_astra.py
# ============================================================

# ---- Node server ----
PORT=3000
NODE_ENV=development

# ---- DataStax Astra DB ----
# Get these from https://astra.datastax.com -> your database -> "Connect" / "Settings":
#
# ASTRA_CLIENT_ID / ASTRA_CLIENT_SECRET:
#   Settings (gear icon) -> Application Tokens -> Generate Token
#   (Role: Database Administrator). Copy the Client ID and Client Secret shown —
#   you cannot view the secret again after closing that dialog.
ASTRA_CLIENT_ID=AstraCS:xxxxxxxxxxxxxxxxxxxxxx
ASTRA_CLIENT_SECRET=your-client-secret-here

# ASTRA_KEYSPACE:
#   The keyspace your tables live in. The app defaults to "vyaapti" if this is unset.
ASTRA_KEYSPACE=vyaapti

# ASTRA_SECURE_BUNDLE_PATH:
#   Connect tab -> "Download Secure Connect Bundle" -> save the zip into backend/
#   Path here is relative to the backend/ folder. Default matches the filename
#   already referenced throughout the code — only change this if you rename the file.
ASTRA_SECURE_BUNDLE_PATH=secure-connect-vyaapti.zip

# ---- Optional / informational (not read by any script, kept for reference) ----
# ASTRA_DB_ID=your-database-id
# ASTRA_REGION=asia-south1
